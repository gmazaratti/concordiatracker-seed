{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/:slug",
      "destination": "/docs/:slug/index.html"
    },
    {
      "source": "/:page(about|contact|developers)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/teacher/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/organizer/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/join/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/legal/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/e/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/s/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:page(app|teacher|organizer|admin|feedback|survey|onboarding|demo|concordia-gpa-calculator|concordia-syllabus-tracker)",
      "destination": "/index.html"
    },
    {
      "source": "/:doc(terms|privacy|privacypolicy|educator)",
      "destination": "/prerendered/:doc.html"
    },
    {
      "source": "/:handle(@?[a-z0-9_]{3,20})",
      "destination": "/index.html"
    },
    {
      "source": "/api/calendar/:token",
      "destination": "/api/calendar?token=:token"
    },
    {
      "source": "/api/library",
      "destination": "/api/sections?feed=library"
    },
    {
      "source": "/api/run-reminders",
      "destination": "/api/sync-catalog?job=reminders"
    },
    {
      "source": "/api/v1",
      "destination": "/api/v1?path="
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/api/stripe-checkout",
      "destination": "/api/stripe-billing?a=checkout"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/not-found?json=1"
    },
    {
      "source": "/:path*",
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/docs/:slug*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/:page(about|contact|developers)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(llms.txt|sitemap.xml|openapi.json|.well-known/openapi.json)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync-catalog?job=outlines",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/sync-catalog?job=moodle",
      "schedule": "10 5 * * *"
    }
  ]
}
